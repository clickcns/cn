# 설치·빌드 결과는 이미지 안에서 새로 만든다.
**/node_modules
**/dist
**/dev-dist
**/.turbo
**/*.tsbuildinfo
# Prisma client 는 빌드 중에 생성한다.
apps/server/src/generated

# 로컬 환경 파일(운영 DB 주소가 든 .env.production 포함). vite 는 빌드 때 .env.* 를 읽으므로
# 들어가면 로컬 값이 번들에 박힌다.
**/.env
**/.env.*

.git
.github
.claude
.vscode
.idea
**/*.log
**/.DS_Store
docs
