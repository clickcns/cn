{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    // dist를 지우면 buildinfo도 함께 지워져야 다음 빌드가 다시 emit한다.
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src"]
}
