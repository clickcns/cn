# 서버 포트 (웹 vite 프록시가 이 포트를 본다)
PORT=3210

# 비밀번호를 4자부터 받는다(개발 편의). pnpm dev가 켜므로 여기서는 두지 않는다. 운영에서는 켤 수 없다.
# ALLOW_SHORT_PASSWORDS=true

# 로컬 PostgreSQL — apps/server/docker-compose.yml (pnpm infra:up)
DATABASE_URL=postgresql://postgres:postgres@localhost:5510/carenote

# JWT — 운영에서는 반드시 길고 서로 다른 값으로 바꾼다.
JWT_ACCESS_SECRET=access-secret-dev-change-in-production
JWT_REFRESH_SECRET=refresh-secret-dev-change-in-production
# 토큰 유효 시간(초)
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=1209600

# 신뢰할 프록시(express trust proxy). 인그레스 뒤에 배포하면 앞단 프록시 수(보통 1)를 넣는다.
# 값을 넓게 잡으면 X-Forwarded-For 위조로 로그인 시도 제한을 우회할 수 있다.
TRUST_PROXY=loopback

# 음성인식 서버(cns speech-stt-app, gRPC). 개발은 NodePort, 클러스터 안에서는
# speech-stt-app.default.svc.cluster.local:50051
STT_GRPC_URL=211.254.168.186:30051

# 기록 초안 LLM — OpenAI 호환 API(기본 Gemini). 키가 비어 있으면 음성인식까지만 한다.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# 생각 정도: low | medium | high
LLM_REASONING_EFFORT=low
